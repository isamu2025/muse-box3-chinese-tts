[Unit]
Description=Muse BOX-3 streaming Chinese speech
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=muse-tts
WorkingDirectory=/opt/muse-box3-tts
Environment=PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=-/etc/muse-box3-tts.env
ExecStart=/opt/muse-box3-tts/.venv/bin/python -m uvicorn tts_server:app --host 0.0.0.0 --port 8765 --no-access-log
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
